        "type": "GRAPHIC",
        "source": "manim",
        "lane": "manim",
        "motion": "assemble",
        "show": [
          {
            "at": 0.1,
            "event": "Actual axis labels the rows; Predicted axis labels the columns"
          },
          {
            "at": 0.4,
            "event": "Diagonal cells fill: True Positive, True Negative"
          },
          {
            "at": 0.65,
            "event": "Off-diagonal cells fill: False Negative (miss), False Positive (false alarm) in terracotta outline"
          },
          {
            "at": 0.85,
            "event": "Plain-language tags settle under each mistake"
          }
        ],
        "manim": {
